<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ShiftDrag" Width="1160" Height="800" MinWidth="1000" MinHeight="750" WindowStartupLocation="CenterScreen" Background="#F7F9FD" FontFamily="Segoe UI" Foreground="#1E293E" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#7358F5"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="17,10"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#363A35"/><Setter Property="BorderBrush" Value="#E3E5DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#DEDFD9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EEF1F9" BorderBrush="#E0E6F2" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" Margin="10,0,0,5"><Border Width="31" Height="31" Background="#F36B32" CornerRadius="11"><TextBlock Text="↗" Foreground="White" FontWeight="Bold" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="ShiftDrag" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="A LITTLE LESS BUSYWORK" FontSize="9" Foreground="#858B80" Margin="11,10,0,34" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,115,0,0" VerticalAlignment="Top">
     <Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂     Workspace" Background="#FFFFFF" FontWeight="SemiBold"/>
     <Button x:Name="ShelfNav" Style="{StaticResource Nav}" Content="▧     Floating shelf"/>
     <Button x:Name="ActivityNav" Style="{StaticResource Nav}" Content="◷     Activity"/>
     <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙     Settings"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#E7EBDD" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="●  Local by nature" Foreground="#526846" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Your files stay on your PC." Foreground="#77816E" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><Button x:Name="HelpNav" Content="?     How it works" Style="{StaticResource Nav}" Margin="0,14,0,0"/><TextBlock Text="SHIFTDRAG  /  WINDOWS  /  v0.2" FontSize="9" Foreground="#92988B" Margin="11,12,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="38,30,38,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR FILES, WITHOUT THE FRICTION" FontSize="10" FontWeight="SemiBold" Foreground="#8C9285"/><TextBlock x:Name="PageTitle" Text="Drag. Drop. Done." FontSize="34" FontWeight="SemiBold" Margin="-2,8,0,5"/><TextBlock x:Name="PageSubtitle" Text="A shortcut from what you have to what you need." Foreground="#80867C" FontSize="13"/></StackPanel><Button x:Name="EnabledButton" Content="●  Running in the tray" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#596F48" Background="#EDF2E7" BorderThickness="0" Padding="12,8" FontSize="11"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,26,0,18"><StackPanel x:Name="PageBody">
    <Border x:Name="Hero" CornerRadius="20" Padding="26,24" Margin="0,0,0,23" BorderBrush="#E4DFF8" BorderThickness="1">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EDE8FE" Offset="0"/><GradientStop Color="#E9F2FF" Offset="0.7"/><GradientStop Color="#E3F4F4" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="ONE GESTURE. MORE POSSIBILITIES." Foreground="#7764AA" FontSize="9" FontWeight="Bold"/><TextBlock Text="Your files.&#10;A little more fluid." FontSize="28" FontWeight="SemiBold" LineHeight="36" Margin="0,11,0,12"/><TextBlock Text="Drag a file. Tap a key. Choose your next step.&#10;A transparent wheel, right where you need it." FontSize="12" Foreground="#6E7B94" LineHeight="19"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Border Background="#EFFFFFFF" Padding="10,6" CornerRadius="7"><TextBlock Text="⇧ Shift" FontWeight="SemiBold" FontSize="11" Foreground="#7050D6"/></Border><TextBlock Text="  convert without opening another app" FontSize="11" Foreground="#77829B" VerticalAlignment="Center"/></StackPanel></StackPanel>
      <Canvas x:Name="HeroWheel" Grid.Column="1" Width="260" Height="224" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Border x:Name="DropZone" Background="White" BorderBrush="#D8DDD1" BorderThickness="1.5" CornerRadius="14" Padding="22,19" AllowDrop="True">
     <Grid><StackPanel Orientation="Horizontal"><Border Background="#F0EDFF" Width="49" Height="49" CornerRadius="12" Margin="0,0,16,0"><TextBlock Text="↓" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7458E8"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DropTitle" Text="Drop files to get started" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DropSubtitle" Text="Images, video, audio, documents, and more." Foreground="#7D8BA1" FontSize="11" Margin="0,5,0,0"/></StackPanel></StackPanel><Button x:Name="BrowseButton" Content="Choose files   +" Background="#7358F5" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Border>
    <WrapPanel x:Name="QuickTools" Margin="0,10,0,0"/>
    <Grid Margin="0,18,0,23"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Border Background="#EEEFEA" CornerRadius="5" Padding="9,5"><TextBlock Text="⇧  Shift" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="  Convert" VerticalAlignment="Center" Foreground="#848A7E" FontSize="11"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="#EEEFEA" CornerRadius="5" Padding="9,5"><TextBlock Text="Alt" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="  File tools" VerticalAlignment="Center" Foreground="#848A7E" FontSize="11"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Background="#EEEFEA" CornerRadius="5" Padding="9,5"><TextBlock Text="Ctrl" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="  File actions" VerticalAlignment="Center" Foreground="#848A7E" FontSize="11"/></StackPanel>
    </Grid>
    <Grid Margin="0,0,0,12"><TextBlock Text="RECENT ACTIVITY" FontSize="10" FontWeight="SemiBold" Foreground="#8C9285"/><Button x:Name="AllActivityButton" Content="View all  →" HorizontalAlignment="Right" Padding="0" BorderThickness="0" Background="Transparent" FontSize="10"/></Grid>
    <StackPanel x:Name="RecentList"><Border BorderBrush="#E5E7DF" BorderThickness="1" CornerRadius="11" Padding="19"><TextBlock Text="All clear. Your next conversion starts with a drag." Foreground="#969B90" FontSize="12"/></Border></StackPanel>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Text="●  Ready when you are" Foreground="#8A9380" FontSize="10"/><TextBlock Text="OFFLINE. ON PURPOSE." HorizontalAlignment="Right" Foreground="#A0A598" FontSize="9" FontWeight="SemiBold"/></Grid>
  </Grid>
 </Grid>
</Window>
